{
  "env": {
    "CLAUDE_VERIFY_CMD": "scripts/verify.sh",
    "HARNESS_TEST_CMD": "scripts/harness_tests.sh {files}",
    "HARNESS_WORKTREE_SETUP": "test -d ../../../.venv && ln -sfn ../../../.venv .venv || true",
    "HARNESS_ULTRAREVIEW": "off",
    "HARNESS_SENSITIVE_PATHS": "data/*.*,data/*/*.*,data/_from_worktree_*/**,data/auto_sync/**,data/backfill_*/**,data/clear_*/**,data/deactivate_clubs/**,data/live_*/**,data/module_fix_*/**,data/outreach_*/**,data/reconcile_*/**,data/rename_club/**,data/retire_*/**,data/reviewqueue_*/**,data/roster_*/**,data/sheet_*/**,data/sf_dupes_*/**,backups/**,credentials/**,.env,.env.*"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)", "Bash(make check)", "Bash(make test)", "Bash(make py)", "Bash(make gs)", "Bash(make secrets)",
      "Bash(make docs-links)", "Bash(make fixtures-check)", "Bash(make lint)", "Bash(make help)",
      "Bash(npm test)", "Bash(npm run check)",
      "Bash(node test/:*)", "Bash(node scripts/check_gs.js)",
      "Bash(python3 test/python_test.py)", "Bash(.venv/bin/python3 test/python_test.py)",
      "Bash(python3 scripts/check_:*)", "Bash(.venv/bin/python3 scripts/check_:*)",
      "Bash(python3 test/fixtures/make_fixture.py --check)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git ls-files:*)", "Bash(git check-ignore:*)", "Bash(git branch:*)", "Bash(git blame:*)",
      "Bash(python3 tools/form_status.py:*)",
      "Bash(python3 backup_forms.py:*)",
      "Bash(python3 tools/needs_attention.py:*)",
      "Bash(python3 tools/add_translations.py --audit:*)",
      "Bash(python3 tools/sheets_client.py tabs)", "Bash(python3 tools/sheets_client.py whoami)",
      "Bash(python3 tools/sheets_client.py export:*)",
      "Bash(python3 tools/sheets_client.py export-all:*)", "Bash(python3 tools/github_switches.py backup)",
      "Bash(sf project retrieve start:*)",
      "Bash(ls:*)", "Bash(wc:*)", "Bash(which:*)", "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(harness-*:*)", "Bash(gh issue:*)", "Bash(gh pr:*)", "Bash(gh api:*)",
      "Bash(git worktree:*)", "Bash(git fetch:*)", "Bash(git add:*)"
    ],
    "ask": [
      "Read(./data/*.*)", "Read(./data/*/*.*)",
      "Read(./data/_from_worktree_*/**)", "Read(./data/auto_sync/**)", "Read(./data/backfill_*/**)",
      "Read(./data/clear_*/**)", "Read(./data/deactivate_clubs/**)", "Read(./data/live_*/**)",
      "Read(./data/module_fix_*/**)", "Read(./data/outreach_*/**)", "Read(./data/reconcile_*/**)",
      "Read(./data/rename_club/**)", "Read(./data/retire_*/**)", "Read(./data/reviewqueue_*/**)",
      "Read(./data/roster_*/**)", "Read(./data/sheet_*/**)", "Read(./data/sf_dupes_*/**)",
      "Read(./backups/**)",
      "Bash(git tag:*)",
      "Bash(python3 tools/derive_partner_regions.py:*)",
      "Bash(python3 test/fixtures/make_fixture.py --write)", "Bash(make fixtures)",
      "Bash(gh variable delete:*)", "Bash(gh secret delete:*)", "Bash(gh variable remove:*)", "Bash(gh secret remove:*)",
      "Bash(sf data delete:*)", "Bash(sf project delete source:*)"
    ],
    "deny": [
      "Read(./credentials/service-account.json)", "Read(./credentials/config.json)",
      "Read(./.env)", "Read(./.env.local)",
      "Read(./.claude/settings.local.json)",
      "Read(~/.clasprc.json)", "Read(~/.config/gcloud/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/live_gate.sh", "timeout": 5, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protected_paths.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret_scan.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
