# Copy to .env (gitignored, chmod 600) and load it in your shell with:
#     set -a; source .env; set +a
# Never put these values on a command line inside Claude Code — command lines
# end up in .claude/settings.local.json and in session transcripts.

# Jotform → My Account → API. Full access is needed for --apply; a read-only
# key is enough for form_status.py, backup_forms.py and dry runs.
JOTFORM_API_KEY=

# The master enrollment sheet: the long token after /d/ in its URL.
# Optional here — credentials/config.json is the other place it can live.
GLOW_SHEET_ID=

# Path to the Google service-account key (default shown).
GLOW_SA_KEY=credentials/service-account.json

# Live writes are approved in the session (docs/RUNBOOK.md, "Live gate (Claude Code)").
